[Unit]
Description=Build and validate domain-only selective routing rules
Wants=network-online.target
After=network-online.target
OnSuccess=ru-selective-publish.service

[Service]
Type=oneshot
User=ru-rules-build
Group=ru-rules
ExecStart=/opt/ru-selective-rules/venv/bin/python /opt/ru-selective-rules/rules.py build
UMask=0027
Environment=GOMEMLIMIT=512MiB
Environment=GOGC=25
MemoryAccounting=yes
MemoryMax=1500M
MemoryHigh=1400M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/ru-selective-rules/build
TimeoutStartSec=45min

