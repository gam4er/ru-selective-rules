[Unit]
Description=Select verified immutable routing release %i as latest
Wants=network-online.target
After=network-online.target ru-selective-build.service ru-selective-publish.service

[Service]
Type=oneshot
User=ru-rules-publish
Group=ru-rules
ExecStart=/opt/ru-selective-rules/venv/bin/python /opt/ru-selective-rules/rules.py select-release --tag %i
LoadCredential=github-app.pem:/etc/ru-selective-rules/github-app.pem
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/ru-selective-rules/build
ReadWritePaths=/var/lib/ru-selective-rules/publish
TimeoutStartSec=30min
